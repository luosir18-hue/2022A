{
  "schema_version": "l-modeling-run-config/v1",
  "owner_name": "罗懿",
  "owner_code": "L",
  "owner_role": "建模手",
  "version": "v2",
  "entrypoint": {
    "code": "solve.cpp",
    "command": [
      "{cpp}",
      "-std=c++17",
      "-O2",
      "-Wall",
      "-Wextra",
      "-o",
      "solve",
      "{code_path}",
      "-lz",
      "&&",
      "./solve"
    ],
    "workdir": "."
  },
  "output_contract": {
    "spec": "结果（包括各种过程数据与审查）/输出验证规则.json",
    "required_files": [
      "result3.xlsx",
      "result3.csv",
      "result3_key.csv",
      "result3_矩阵特性.csv",
      "result3_几何约束检查.csv",
      "result3_线性化适用性.csv",
      "result3_响应幅值摘要.csv"
    ],
    "expected_counts": {},
    "required_columns": {},
    "constraint_validation": "external"
  },
  "precomputation": {
    "inventory": "预计算数据清单.md",
    "asset_root": "结果（包括各种过程数据与审查）/预计算资产",
    "reuse_policy": "reuse_only_when_key_and_hash_match",
    "cache_mismatch": "recompute_or_block"
  },
  "independent_review": {
    "problem_source": "题目简报.md",
    "model_sources": [
      "模型/{question}/v3/数学模型.md",
      "模型/{question}/v3/建模思路.md",
      "模型/{question}/v3/约束.md"
    ],
    "ignored_inputs": [
      "algorithm",
      "code"
    ]
  }
}
